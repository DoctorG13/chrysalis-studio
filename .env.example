# Chrysalis Studio production environment
# Never commit a real .env file or real credentials.

NODE_ENV=production

# Railway provides PORT automatically. Do not set it manually unless needed locally.

# Persistent Railway Volume should be mounted at /app/data.
CHRYSALIS_DATA_DIR=/app/data

# Production login credentials.
# Use a unique username and a strong password of at least 12 characters.
CHRYSALIS_AUTH_USERNAME=Donna
CHRYSALIS_AUTH_PASSWORD=replace-with-a-strong-password

# Generate a random value of at least 32 characters.
# Example locally: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
CHRYSALIS_SESSION_SECRET=replace-with-a-long-random-secret
